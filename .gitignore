# ---- Runtime data: conversations, accounts, vault, logs. Created by the server; never commit. ----
.agentflow/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# ---- Agent workspace: projects, reports, media and skills the agents create at runtime ----
/workspaces/

# ---- Backups and exports (reset backups contain old databases) ----
/artifacts/
*.tar.gz
*.zip

# ---- Agent scratch folders at the repository root (client projects, audits) ----
/audit-reports/
/backend/

# ---- Secrets and credentials (keep .env.example, it holds names only) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
credentials.bin
*.secret

# ---- Local tool state and editor settings ----
/.openai/
/.codex/
/.claude/
/.vscode/
/.idea/
/premium-*.json
/.work/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Node ----
node_modules/

# ---- Logs ----
*.log

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# Accidental nested clones of this repository (would be committed as an empty submodule)
/AgentFlow-Bot/
